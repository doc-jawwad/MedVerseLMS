# Local development — never point this file at Cloud production.
#
# Preferred: local `supabase start` (Docker) so pgTAP and the app share a throwaway DB.
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#
# Cloud staging `vygtwrsshcyfahfzurgq` exists but must not be modified unless
# explicitly approved (docs/deployment.md). Do not use production
# `pxoxijlhcvbrostrquft` locally (Vercel Production / live data).
#
# Copy to .env.local (gitignored). Never commit filled values.

MEDVERSE_ENV=local

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL for pgTAP (local supabase db is typically port 54322).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional override for pgTAP only; defaults to SUPABASE_DB_URL.
# PGTAP_DB_URL=
# Guards /api/cron/auto-submit and /api/health/ready (local value; do not reuse production)
CRON_SECRET=local-dev-only-not-production
# Local Playwright only. Required for `npm run test:e2e` (no built-in password fallback).
# E2E_ADMIN_EMAIL=admin@medverse.local
# E2E_ADMIN_PASSWORD=
# Optional. On VPS this is http://127.0.0.1:3001 ; locally the hosted/local Kong /rest/v1 works via NEXT_PUBLIC_SUPABASE_URL.
# POSTGREST_INTERNAL_URL=

# Payment screenshots — private R2. Server-only. Never NEXT_PUBLIC_.
# Leave unset locally unless you are testing uploads against a real bucket.
# Prefer R2_PAYMENT_BUCKET. R2_BUCKET is a non-production fallback only.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PAYMENT_BUCKET=
# R2_BUCKET=
# R2_ENDPOINT=
