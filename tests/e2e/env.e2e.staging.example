# Staging Playwright E2E — copy to repo root as `.env.e2e.staging` (gitignored).
# Never put production (`pxoxijlhcvbrostrquft` / lms.medversepk.com) values here.
#
#   copy tests\e2e\env.e2e.staging.example .env.e2e.staging
#   $env:E2E_TARGET="staging"; npx playwright test tests/e2e/staging-smoke.spec.ts

E2E_TARGET=staging
PLAYWRIGHT_BASE_URL=https://staging.medversepk.com

# App origin (browser + PostgREST via Caddy)
NEXT_PUBLIC_SUPABASE_URL=https://staging.medversepk.com
E2E_REST_URL=https://staging.medversepk.com

# Cloud staging Auth (direct) — used for Auth Admin + password grant from the harness
E2E_AUTH_URL=https://vygtwrsshcyfahfzurgq.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Staging admin (publish_test / close_test_now / REST writes when service key is not a JWT)
E2E_ADMIN_EMAIL=staging-admin@medverse.local
E2E_ADMIN_PASSWORD=

# Optional dedicated smoke-login student
E2E_STAGING_STUDENT_EMAIL=staging-student@medverse.local
E2E_STAGING_STUDENT_PASSWORD=

# SSH HostAlias for privileged SQL (enrollments year-change, attempt expiry, sub expire)
# when admin JWT cannot mutate rows under RLS. Must target medverse_staging only.
E2E_STAGING_SSH=medverse-vps
