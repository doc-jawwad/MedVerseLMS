[Unit]
Description=MedVerse LMS encrypted Postgres dump to Cloudflare R2
Documentation=file:///opt/medverse/current/docs/deployment.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=medverse
Group=medverse
UMask=0077
EnvironmentFile=/etc/medverse/backup.env
# systemd PATH does not include /snap/bin; AWS CLI v2 is installed as a snap.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
Environment=HOME=/home/medverse
# Default tag for the timer. Override for a pre-exam dump:
#   MEDVERSE_BACKUP_TAG=pre-exam /opt/medverse/current/deploy/scripts/backup-to-r2.sh
Environment=MEDVERSE_BACKUP_TAG=scheduled
ExecStart=/usr/bin/bash /opt/medverse/current/deploy/scripts/backup-to-r2.sh
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
# EnvironmentFile values must not appear in logs; the script never echoes secrets.

[Install]
WantedBy=multi-user.target
