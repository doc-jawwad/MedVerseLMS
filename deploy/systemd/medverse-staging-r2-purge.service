[Unit]
Description=MedVerse LMS staging R2 purge queue consumer
Documentation=file:///opt/medverse-staging/current/docs/deployment.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=medverse
Group=medverse
EnvironmentFile=/etc/medverse-staging/nextjs.env
Environment=MEDVERSE_DATABASE=medverse_staging
Environment=R2_PURGE_LIMIT=50
# bash wrapper: durable even if release tree loses +x (rsync/umask).
ExecStart=/usr/bin/bash /opt/medverse-staging/current/deploy/scripts/r2-purge-once.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
