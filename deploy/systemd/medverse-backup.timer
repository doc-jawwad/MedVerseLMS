[Unit]
Description=MedVerse LMS daily encrypted database backup to R2
Documentation=file:///opt/medverse/current/docs/deployment.md

[Timer]
# Daily 02:00 Asia/Karachi (VPS local time) ≈ 21:00 UTC. Low-traffic window.
# Persistent=true runs a catch-up dump if the host was down at 02:00.
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=5min
AccuracySec=1min
Persistent=true
Unit=medverse-backup.service

[Install]
WantedBy=timers.target
