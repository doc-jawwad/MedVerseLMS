# Append-only staging site for /etc/caddy/Caddyfile.
# Do not replace or edit the production site block.
# Hostname is staging.medversepk.com so the existing Origin CA
# SAN (*.medversepk.com) covers TLS. A hostname under lms. would not.

https://staging.medversepk.com {
	tls /etc/medverse/tls/origin.pem /etc/medverse/tls/origin.key
	encode gzip

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# HSTS at Caddy (Cloudflare forwards origin headers). Conservative
		# max-age only — no includeSubDomains / preload until soak is clean.
		Strict-Transport-Security "max-age=86400"
		# Staging-only: ask Cloudflare not to transform HTML. Official CF behavior
		# skips Email Address Obfuscation (email-decode.min.js) when no-transform
		# is present — keeps CSP script-src nonce/strict-dynamic intact.
		# Prefer a hostname Configuration Rule when CF API access is available;
		# do not disable zone-wide (would affect production lms.).
		+Cache-Control "no-transform"
		-Server
	}

	handle /auth/v1* {
		header Cache-Control "no-store, no-transform"
		reverse_proxy https://vygtwrsshcyfahfzurgq.supabase.co {
			header_up Host vygtwrsshcyfahfzurgq.supabase.co
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			transport http {
				tls
			}
		}
	}

	handle /rest/v1* {
		header Cache-Control "no-store, no-transform"
		uri strip_prefix /rest/v1
		reverse_proxy 127.0.0.1:3011 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3010 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
	}
}
