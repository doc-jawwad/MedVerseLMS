# Next.js on the VPS. Copy to /etc/medverse/nextjs.env (mode 0640, user medverse).
# Names match the Vercel/portable client (docs/architecture.md).

MEDVERSE_ENV=vps-staging
# MEDVERSE_ENV=production

# Public origin Caddy serves (same host the browser uses). Not *.supabase.co after cutover.
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_PUBLIC_ORIGIN
# Cloud Auth API key (sb_publishable_* or legacy JWT). Never a PostgREST Bearer.
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_CLOUD_ANON_KEY
# Server-only Cloud Auth secret (sb_secret_* or legacy service_role JWT).
# Opaque sb_* keys are not sent to VPS PostgREST as Authorization.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
CRON_SECRET=REPLACE_ME

# Ready-check probe of loopback PostgREST. Do not publish this URL.
POSTGREST_INTERNAL_URL=http://127.0.0.1:3001

# Payment screenshots (private R2). Server-only. Never NEXT_PUBLIC_.
# Production (MEDVERSE_ENV=production) REQUIRES R2_PAYMENT_BUCKET — no fallback to R2_BUCKET
# (backup dumps use /etc/medverse/backup.env, not this file).
# R2_ACCOUNT_ID=REPLACE_ME
# R2_ACCESS_KEY_ID=REPLACE_ME
# R2_SECRET_ACCESS_KEY=REPLACE_ME
# R2_PAYMENT_BUCKET=medverse-prod-payment-proofs
# R2_ENDPOINT=
