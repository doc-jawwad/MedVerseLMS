# PostgREST on the VPS. Copy to /etc/medverse/postgrest.env (mode 0640).
# PGRST_* are native PostgREST environment variables.

MEDVERSE_ENV=vps-staging

# Loopback only. Password is the authenticator role, not postgres superuser.
PGRST_DB_URI=postgres://authenticator:REPLACE_ME@127.0.0.1:5432/medverse
PGRST_DB_SCHEMAS=public
PGRST_DB_ANON_ROLE=anon
PGRST_SERVER_HOST=127.0.0.1
PGRST_SERVER_PORT=3001
PGRST_DB_POOL=10

# Must equal the Cloud Auth JWT secret. File on disk is preferred over this env:
#   PGRST_JWT_SECRET=@/etc/medverse/jwt-secret
PGRST_JWT_SECRET=REPLACE_ME
PGRST_JWT_AUD=authenticated
