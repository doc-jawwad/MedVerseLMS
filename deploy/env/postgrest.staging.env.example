# Copy to /etc/medverse-staging/postgrest.env (mode 0640).
# Do not copy /etc/medverse/postgrest.env.

MEDVERSE_ENV=vps-staging
PGRST_DB_URI=postgres://authenticator_staging:REPLACE_ME@127.0.0.1:5432/medverse_staging
PGRST_DB_SCHEMAS=public
PGRST_DB_ANON_ROLE=anon
PGRST_SERVER_HOST=127.0.0.1
PGRST_SERVER_PORT=3011
PGRST_DB_POOL=5
PGRST_JWT_SECRET=@/etc/medverse-staging/jwks.json
PGRST_JWT_AUD=authenticated
PGRST_JWT_SECRET_IS_BASE64=false
