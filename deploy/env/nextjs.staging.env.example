# Copy to /etc/medverse-staging/nextjs.env (mode 0640, user medverse).
# Do not copy /etc/medverse/nextjs.env.

MEDVERSE_ENV=vps-staging
# CSP: report-only (default) → enforce after staging console validation; off disables.
# MEDVERSE_CSP_MODE=report-only
# MEDVERSE_CSP_MODE=enforce
NEXT_PUBLIC_SUPABASE_URL=https://staging.medversepk.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_CLOUD_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_STAGING_CLOUD_SECRET
CRON_SECRET=REPLACE_ME
POSTGREST_INTERNAL_URL=http://127.0.0.1:3011
# Prefer R2_PAYMENT_BUCKET. R2_BUCKET remains a non-production fallback only.
R2_PAYMENT_BUCKET=medverse-staging-private
# R2_BUCKET=medverse-staging-private
# R2_ACCOUNT_ID=REPLACE_ME
# R2_ACCESS_KEY_ID=REPLACE_ME
# R2_SECRET_ACCESS_KEY=REPLACE_ME
# Dedicated HMAC secret for study PDF upload session tokens (preferred).
# If unset, code falls back to a keyed derivation from R2_SECRET_ACCESS_KEY.
# Generate out-of-band (openssl rand -hex 32); never commit the value.
# STUDY_UPLOAD_SESSION_SECRET=
# Sentry (optional until DSN provisioned):
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
# SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_RELEASE=