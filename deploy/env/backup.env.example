# Backup job. Copy to /etc/medverse/backup.env (mode 0640, root:medverse).
# Timer: medverse-backup.timer — daily 02:00 Asia/Karachi. Keep 14 scheduled copies.

MEDVERSE_ENV=vps-staging
# Production dumps also require:
# MEDVERSE_BACKUP_CONFIRM=I_UNDERSTAND_PRODUCTION

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=medverse
PGUSER=postgres
# Prefer a .pgpass file (0600) instead of PGPASSWORD in this env.
# PGPASSWORD=REPLACE_ME

# Symmetric key for openssl enc -aes-256-cbc -pbkdf2. Not the JWT secret.
DUMP_ENCRYPTION_KEY=REPLACE_ME

# Cloudflare R2 (S3-compatible). Account id is not a secret; keys are.
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET=REPLACE_ME
# Optional; default is https://<accountid>.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Integer in 7–14 (docs/deployment.md). Default 14. Applies to scheduled/ only.
BACKUP_KEEP_COUNT=14
